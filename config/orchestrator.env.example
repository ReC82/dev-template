# Configuration de l'orchestrateur — copiée hors Git (/etc/<orch>/orch.env, 0600) par
# scripts/prepare-orchestrator.sh. AUCUN secret ici : les secrets sont des FICHIERS référencés (*_FILE).
ORCH_NAME=
PROJECT_NAME=
GITHUB_REPO=
REPO_DIR=
WORKTREES_DIR=
ORCH_STATE_DIR=
BASE_BRANCH=main
POLL_SECONDS=300

# Sessions Claude Code et plafonds de coût
GH_BIN=gh
CLAUDE_BIN=claude
CLAUDE_ARGS=-p
SESSION_TIMEOUT_MINUTES=120
MAX_ATTEMPTS=2
MAX_SESSIONS_PER_DAY=6

# Porte locale, fusion et livraison (AUTO_MERGE=1 seulement après accord écrit du propriétaire)
GATE_CMD=scripts/check-contract.sh
AUTO_MERGE=0
DEPLOY_CMD=
PUBLIC_URL=
SMOKE_FILE=config/smoke.txt
DASHBOARD_ISSUE=

# Notifications e-mail (obligatoires) — docs/EMAIL_REPORTS.md
NOTIFY_TRANSPORT=file
NOTIFY_TO=
NOTIFY_FROM=
NOTIFY_MAX_RETRIES=3
NOTIFY_MAX_ATTEMPTS=10
NOTIFY_BACKOFF_SECONDS=5
NOTIFY_RESUME_DEDUP_HOURS=6
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD_FILE=
