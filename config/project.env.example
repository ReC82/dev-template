# Paramètres du projet (non secrets). scripts/init_project.py écrit la version réelle dans
# .devtemplate/project.env. Variables d'exécution de l'application : voir docs/DEPLOYMENT.md.
PROJECT_NAME=
PROJECT_SLUG=
GITHUB_REPO=
PROJECT_DOMAIN=
PROJECT_PORT=8080
STACK=node
LOCALES=fr,en

# Exécution (application) — contrat universel
HOST=127.0.0.1
PORT=8080
APP_DATA_DIR=./data
